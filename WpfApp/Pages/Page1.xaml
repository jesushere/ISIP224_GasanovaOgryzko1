<Page x:Class="WpfApp.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CHOOSING A CAR">
    <Grid Background="#090B10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.9*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="35,30,20,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                   Text="01 / CAR SELECTION"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="#540104"
                   Margin="0,0,0,18"/>
            <StackPanel Grid.Row="1">
                <TextBlock Text="Choose your car"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#F2F2F2"/>
                <TextBlock Text="Your next car is already here. All that’s left is to choose."
                       FontSize="14"
                       Foreground="#858B96"
                       Margin="0,8,0,30"/>
            </StackPanel>
            <StackPanel Grid.Row="2">
                <TextBlock Text="SELECT MODEL"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#F2F2F2"
                       Margin="0,0,0,12"/>
                <ComboBox x:Name="ModelComboBox"
                      Height="29"
                      FontSize="14"
                      SelectedIndex="0"
                      Foreground="#151922"
                      Padding="10,5">
                    <ComboBoxItem Content="Lamborghini Aventador SVJ"/>
                    <ComboBoxItem Content="Ferrari SF90 Stradale"/>
                    <ComboBoxItem Content="McLaren 765LT"/>
                    <ComboBoxItem Content="Porsche 911 GT3 RS"/>
                    <ComboBoxItem Content="Aston Martin DBS Superleggera"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,30,0,0">
                <TextBlock Text="ENGINE TYPE"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#F2F2F2"
                       Margin="0,0,0,15"/>
                <RadioButton x:Name="PetrolRadioButton"
                         Content="Petrol"
                         GroupName="Engine"
                         IsChecked="True"
                         Foreground="#E8E8E8"
                         FontSize="15"
                         Margin="0,7"/>
                <RadioButton x:Name="DieselRadioButton"
                         Content="Diesel"
                         GroupName="Engine"
                         Foreground="#E8E8E8"
                         FontSize="15"
                         Margin="0,7"/>
                <RadioButton x:Name="ElectricRadioButton"
                         Content="Electric"
                         GroupName="Engine"
                         Foreground="#E8E8E8"
                         FontSize="15"
                         Margin="0,7"/>
            </StackPanel>
            <Button Grid.Row="5"
                    Content="CONTINUE"
                    Width="170"
                    Height="35"
                    Click="NextButton_Click"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#F2F2F2"
                    Background="#540104"
                    BorderBrush="#151922"     
                    
                    BorderThickness="1"/>
        </Grid>
        <Border Grid.Column="1"
            Margin="20,75,25,75"
            Background="White"
            CornerRadius="10"
            Padding="10">
            <Border CornerRadius="12"
                ClipToBounds="True">
                <Image x:Name="CarImage"
                    Stretch="UniformToFill"/>
            </Border>
        </Border>
    </Grid>
</Page>
