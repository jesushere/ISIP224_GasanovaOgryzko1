<Page x:Class="WpfApp.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Equipment">
    <Grid Background="#090B10">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="35,15">
        <TextBlock Text="02 / CUSTOMIZATION"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#343B48"
                       Margin="0,0,0,18"/>
            <TextBlock Text="Customize your car"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#F2F2F2"/>
            <Border Background="#151922"
                    BorderBrush="#343B48"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="BODY COLOR"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#F2F2F2"
                               Margin="0,0,0,15"/>
                    <ComboBox x:Name="ColorComboBox"
                              Height="29"
                              FontSize="14"
                              SelectedIndex="0"
                              Foreground="#151922"
                              Padding="10,5">
                        <ComboBoxItem Content="White"/>
                        <ComboBoxItem Content="Gray"/>
                        <ComboBoxItem Content="Gold"/>
                        <ComboBoxItem Content="Black"/>
                        <ComboBoxItem Content="Red"/>
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border Background="#151922"
                    BorderBrush="#343B48"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="ADDITIONAL OPTIONS"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#F2F2F2"
                               Margin="0,0,0,18"/>
                    <CheckBox x:Name="NightVisionCheckBox"
                              Content="Night Vision  (+$3 500)"
                              FontSize="12"
                              Foreground="#E8E8E8"
                              Margin="0,0,0,15"/>
                    <CheckBox x:Name="StarlightHeadliinerCheckBox"
                              Content="Starlight Headliner  (+$15 000)"
                              FontSize="12"
                              Foreground="#E8E8E8"
                              Margin="0,0,0,15"/>
                    <CheckBox x:Name="ElectrochromicRoofCheckBox"
                              Content="Electrochromic Roof  (+$4 500)"
                              FontSize="12"
                              Foreground="#E8E8E8"
                              Margin="0,0,0,15"/>
                    <CheckBox x:Name="RearCameraCheckBox"
                              Content="Rear Camera  (+$800)"
                              FontSize="12"
                              Foreground="#E8E8E8"
                              Margin="0,0,0,5"/>
                <TextBlock Text="The cost of selected options will be added to the car's price."
                               FontSize="12"
                               Foreground="#858B96"
                               FontStyle="Italic"
                               Margin="0,9,0,0"/>
            </StackPanel>
            </Border>
            <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="BACK"
                        Width="130"
                        Height="42"
                        HorizontalAlignment="Left"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="#C5A46D"
                        Background="#151922"
                        BorderBrush="#C5A46D"
                        BorderThickness="1"
                        Click="BackButton_Click"/>

                <Button Grid.Column="1"
                        Content="CONTINUE"
                        Width="160"
                        Height="42"
                        HorizontalAlignment="Right"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="#090B10"
                        Background="#C5A46D"
                        BorderBrush="#C5A46D"
                        BorderThickness="1"
                        Click="NextButton_Click"/>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
