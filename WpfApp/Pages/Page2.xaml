<Page x:Class="WpfApp.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Equipment">

    <Grid Background="AliceBlue">
        <StackPanel Margin="25">
            <TextBlock Text="Step 2. Choosing Equipment"
                       FontSize="21"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Select the desired equipment for your car"
                       FontSize="14"/>
            <TextBlock Text="Equipment"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="Red"
                       Margin="0,0,0,10"/>
            <CheckBox x:Name="SunroofCheckBox"
                      Content="Sunroof"
                      FontSize="16"
                      Margin="0,5"/>
            <CheckBox x:Name="LeatherSeatsCheckBox"
                      Content="Leather Seats"
                      FontSize="16"
                      Margin="0,5"/>
            <CheckBox x:Name="SportsPackageCheckBox"
                      Content="Sports Package"
                      FontSize="16"
                      Margin="0,5"/>
            
        </StackPanel>
    </Grid>
</Page>
