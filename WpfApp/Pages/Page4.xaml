<Page x:Class="WpfApp.Pages.Page4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Calculation of loan parameters">

    <Grid Background="AliceBlue">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25">
                <TextBlock Text="Step 4. Calculation of loan parameters" 
                       FontSize="21" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>
                <TextBlock Text="Set the down payment and loan period"
                           FontSize="16"
                           Margin="0,0,0,25"/>
                <Border Background="Beige"
                        CornerRadius="10"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Down payment"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>
                        <TextBlock x:Name="DownPaymentPercentTextBlock"
                                   Text="Down payment: 20%"
                                   FontSize="17"
                                   Margin="0,0,0,10"/>
                        <Slider x:Name="DownPaymentSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="20"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                ValueChanged="DownPaymentSlider_ValueChanged"/>
                        <TextBlock Text="Loan period"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,25,0,10"/>

                        <ComboBox x:Name="LoanMonthsComboBox"
                                  Height="40"
                                  FontSize="16"
                                  SelectedIndex="2"
                                  SelectionChanged="LoanMonthsComboBox_SelectionChanged">
                            <ComboBoxItem Content="12 months"/>
                            <ComboBoxItem Content="24 months"/>
                            <ComboBoxItem Content="36 months"/>
                            <ComboBoxItem Content="48 months"/>
                            <ComboBoxItem Content="60 months"/>
                            <ComboBoxItem Content="72 months"/>
                            <ComboBoxItem Content="84 months"/>
                            <ComboBoxItem Content="96 months"/>
                        </ComboBox>
                        <Separator Margin="0,25,0,15"/>

                        <TextBlock Text="Loan calculation"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#202A44"
                                   Margin="0,0,0,15"/>
                        <TextBlock x:Name="TotalPriceTextBlock"
                                   FontSize="16"
                                   Margin="0,5"/>
                        <TextBlock x:Name="DownPaymentTextBlock"
                                   FontSize="16"
                                   Margin="0,5"/>
                        <TextBlock x:Name="CreditAmountTextBlock"
                                   FontSize="16"
                                   Margin="0,5"/>
                        <Separator Margin="0,15"/>
                        <TextBlock x:Name="MonthlyPaymentTextBlock"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#202A44"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,25,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Back"
                            Width="130"
                            Height="40"
                            HorizontalAlignment="Left"
                            Click="BackButton_Click"/>

                    <Button Grid.Column="1"
                            Content="Next"
                            Width="130"
                            Height="40"
                            HorizontalAlignment="Right"
                            Click="NextButton_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
