<Page x:Class="WpfApp.Pages.Page4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Calculation of loan parameters">
    <Grid Background="#090B10">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="35,20">
                <TextBlock Text="04 / LOAN PARAMETERS"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#343B48"
                           Margin="0,0,0,15"/>
                <TextBlock Text="Loan calculation"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#F2F2F2"/>
                <TextBlock Text="Choose your down payment and preferred loan period."
                           FontSize="14"
                           Foreground="#858B96"
                           Margin="0,8,0,25"/>
                <Border Background="#151922"
                        BorderBrush="#343B48"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="DOWN PAYMENT"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#C5A46D"
                                   Margin="0,0,0,15"/>
                        <TextBlock x:Name="DownPaymentPercentTextBlock"
                                   Text="Down payment: 20%"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#F2F2F2"
                                   Margin="0,0,0,15"/>
                        <Slider x:Name="DownPaymentSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="20"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                ValueChanged="DownPaymentSlider_ValueChanged"/>
                        <TextBlock Text="LOAN PERIOD"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#C5A46D"
                                   Margin="0,30,0,12"/>
                        <ComboBox x:Name="LoanMonthsComboBox"
                                  Foreground="#151922"
                                  Height="27"
                                  FontSize="14"
                                  SelectedIndex="2"
                                  SelectionChanged="LoanMonthsComboBox_SelectionChanged">
                            <ComboBoxItem Content="12 months"/>
                            <ComboBoxItem Content="24 months"/>
                            <ComboBoxItem Content="36 months"/>
                            <ComboBoxItem Content="48 months"/>
                            <ComboBoxItem Content="60 months"/>
                            <ComboBoxItem Content="72 months"/>
                            <ComboBoxItem Content="84 months"/>
                            <ComboBoxItem Content="96 months"/>
                        </ComboBox>
                        <Separator Background="#343B48"
                                   Margin="0,25,0,20"/>
                        <TextBlock Text="PAYMENT SUMMARY"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#C5A46D"
                                   Margin="0,0,0,15"/>
                        <TextBlock x:Name="TotalPriceTextBlock"
                                   FontSize="15"
                                   Foreground="#E8E8E8"
                                   Margin="0,5"/>
                        <TextBlock x:Name="DownPaymentTextBlock"
                                   FontSize="15"
                                   Foreground="#E8E8E8"
                                   Margin="0,5"/>
                        <TextBlock x:Name="CreditAmountTextBlock"
                                   FontSize="15"
                                   Foreground="#E8E8E8"
                                   Margin="0,5"/>
                        <Separator Background="#343B48"
                                   Margin="0,20"/>
                        <TextBlock x:Name="MonthlyPaymentTextBlock"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#C5A46D"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,25,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="BACK"
                            Width="130"
                            Height="42"
                            HorizontalAlignment="Left"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#C5A46D"
                            Background="#151922"
                            BorderBrush="#C5A46D"
                            BorderThickness="1"
                            Click="BackButton_Click"/>
                    <Button Grid.Column="1"
                            Content="CONTINUE"
                            Width="160"
                            Height="42"
                            HorizontalAlignment="Right"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#090B10"
                            Background="#C5A46D"
                            BorderBrush="#C5A46D"
                            BorderThickness="1"
                            Click="NextButton_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
