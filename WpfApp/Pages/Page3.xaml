<Page x:Class="WpfApp.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="The cost of the car">

    <Grid Background="AliceBlue">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25">
                <TextBlock Text="Step 3. The cost of the car"
                       FontSize="21"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
                <TextBlock Text="Here you can see the calculation of the car's cost"
                       FontSize="14"/>
                <TextBlock Text="The cost of the car"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="Red"
                       Margin="0,0,0,10"/>
                <TextBlock Text="Chek the final configuration and cost"
                       FontSize="14"
                       Margin="0,0,0,10"/>
                <Border Background="Green"
                    CornerRadius="10"
                    Padding="15">
                    <StackPanel>
                        <TextBlock Text="Your configuration"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,1"/>
                        <TextBlock x:Name="ModelTextBlock"
                               FontSize="17"
                               Margin="0,3"/>
                        <TextBlock x:Name="EngineTextBlock"
                                 FontSize="17"
                                 Margin="0,3"/>
                        <TextBlock x:Name="ColorTextBlock"
                                 FontSize="17"
                                 Margin="0,3"/>
                        <TextBlock Text="Additional options"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,10,0,5"/>
                        <TextBlock x:Name="OptionsTextBlock"
                                 FontSize="15"
                               TextWrapping="Wrap"
                               Foreground="Gray"
                                 Margin="0,0,0,15"/>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="Cost calculation"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,10,0,15"/>
                        <TextBlock x:Name="BasePriceTextBlock"
                               FontSize="16"
                               Margin="0,5"/>
                        <TextBlock x:Name="EnginePriceTextBlock"
                               FontSize="16"
                               Margin="0,5"/>
                        <TextBlock x:Name="ColorPriceTextBlock"
                               FontSize="16"
                               Margin="0,5"/>
                        <TextBlock x:Name="OptionsPriceTextBlock"
                               FontSize="16"
                               Margin="0,5"/>
                        <Separator Margin="0,15"/>
                        <TextBlock x:Name="TotalPriceTextBlock"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#202A44"
                               Margin="0,10,0,0"/>
                        <Grid Margin="0,25,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Back"
                                    Width="150"
                                    Height="45"
                                    HorizontalAlignment="Left"
                                    Click="BackButton_Click"/>
                            <Button Grid.Column="1"
                                    Content="Next"
                                    Width="150"
                                    Height="45"
                                    HorizontalAlignment="Right"
                                    Click="NextButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
