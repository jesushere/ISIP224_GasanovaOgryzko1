<Page x:Class="WpfApp.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="The cost of the car">
    <Grid Background="#090B10">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="35,20">
                <TextBlock Text="03 / PRICE OVERVIEW"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#343B48"
                           Margin="0,0,0,15"/>
                <TextBlock Text="Your car configuration"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#F2F2F2"/>
                <Border Background="#151922"
                        BorderBrush="#343B48"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="YOUR CONFIGURATION"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#F2F2F2"
                                   Margin="0,0,0,18"/>
                        <TextBlock x:Name="ModelTextBlock"
                                   FontSize="17"
                                   Foreground="#F2F2F2"
                                   Margin="0,4"/>
                        <TextBlock x:Name="EngineTextBlock"
                                   FontSize="15"
                                   Foreground="#F2F2F2"
                                   Margin="0,4"/>
                        <TextBlock x:Name="ColorTextBlock"
                                   FontSize="15"
                                   Foreground="#F2F2F2"
                                   Margin="0,4"/>
                        <Separator Background="#343B48"
                                   Margin="0,18"/>
                        <TextBlock Text="ADDITIONAL OPTIONS"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#F2F2F2"
                                   Margin="0,5,0,12"/>
                        <TextBlock x:Name="OptionsTextBlock"
                                   FontSize="14"
                                   Foreground="#F2F2F2"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,5"/>
                        <Separator Background="#343B48"
                                   Margin="0,18"/>
                        <TextBlock Text="COST CALCULATION"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#F2F2F2"
                                   Margin="0,5,0,15"/>
                        <TextBlock x:Name="BasePriceTextBlock"
                                   FontSize="15"
                                   Foreground="#F2F2F2"
                                   Margin="0,5"/>
                        <TextBlock x:Name="EnginePriceTextBlock"
                                   FontSize="15"
                                   Foreground="#F2F2F2"
                                   Margin="0,5"/>
                        <TextBlock x:Name="ColorPriceTextBlock"
                                   FontSize="15"
                                   Foreground="#F2F2F2"
                                   Margin="0,5"/>
                        <TextBlock x:Name="OptionsPriceTextBlock"
                                   FontSize="15"
                                   Foreground="#F2F2F2"
                                   Margin="0,5"/>
                        <Separator Background="#343B48"
                                   Margin="0,18"/>
                        <TextBlock x:Name="TotalPriceTextBlock"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#F2F2F2"
                                   Margin="0,5,0,0"/>
                        <Grid Margin="0,25,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="BACK"
                                    Width="130"
                                    Height="42"
                                    HorizontalAlignment="Left"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="#C5A46D"
                                    Background="#151922"
                                    BorderBrush="#C5A46D"
                                    BorderThickness="1"
                                    Click="BackButton_Click"/>
                            <Button Grid.Column="1"
                                    Content="CONTINUE"
                                    Width="160"
                                    Height="42"
                                    HorizontalAlignment="Right"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="#090B10"
                                    Background="#C5A46D"
                                    BorderBrush="#C5A46D"
                                    BorderThickness="1"
                                    Click="NextButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
