<Page x:Class="WpfApp.Pages.Page5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Submitting an application">

    <Grid Background="AliceBlue">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25">
                <TextBlock Text="Step 5. Submitting an application"
                       FontSize="25"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
                <TextBlock Text="Enter your contact information."
                       FontSize="16"
                       Margin="0,0,0,25"/>
                <Border Background="White"
                        CornerRadius="10"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Contact information"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#202A44"
                                   Margin="0,0,0,20"/>
                        <TextBlock Text="Name"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="NameTextBox"
                                 Height="35"
                                 FontSize="16"
                                 MaxLength="50"
                                 TextChanged="Input_TextChanged"
                                 Margin="0,0,0,15"/>
                        <TextBlock Text="Phone"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="PhoneTextBox"
                                 Height="35"
                                 FontSize="16"
                                 MaxLength="15"
                                 TextChanged="Input_TextChanged"
                                 PreviewTextInput="PhoneTextBox_PreviewTextInput"
                                 Margin="0,0,0,15"/>
                        <TextBlock Text="Email"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="EmailTextBox"
                                 Height="35"
                                 FontSize="16"
                                 MaxLength="100"
                                 TextChanged="Input_TextChanged"
                                 Margin="0,0,0,15"/>
                        <TextBlock x:Name="ValidationTextBlock"
                                   Foreground="Red"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,10"/>
                    </StackPanel>
                </Border>
                <Border Background="White"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Application summary"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#202A44"
                                   Margin="0,0,0,15"/>
                        <TextBlock x:Name="SummaryTextBlock"
                                   FontSize="15"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,25,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Back"
                            Width="130"
                            Height="40"
                            HorizontalAlignment="Left"
                            Click="BackButton_Click"/>

                    <Button x:Name="SubmitButton"
                            Grid.Column="1"
                            Content="Submit application"
                            Width="180"
                            Height="40"
                            HorizontalAlignment="Right"
                            IsEnabled="False"
                            Click="SubmitButton_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
