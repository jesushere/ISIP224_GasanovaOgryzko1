<Page x:Class="WpfApp.Pages.Page5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Submitting an application">
    <Grid Background="#090B10">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="35,20">
                <TextBlock Text="05 / SUBMITTING AN APPLICATION"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#343B48"
                           Margin="0,0,0,15"/>
                <TextBlock Text="Complete your application"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#F2F2F2"/>
                <Border Background="#151922"
                        BorderBrush="#343B48"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="CONTACT INFORMATION"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#F2F2F2"
                                   Margin="0,0,0,20"/>
                        <TextBlock Text="FULL NAME"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#C5A46D"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="NameTextBox"
                                 Height="30"
                                 FontSize="15"
                                 MaxLength="50"
                                 TextChanged="Input_TextChanged"
                                 Margin="0,0,0,18"/>
                        <TextBlock Text="PHONE NUMBER"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#C5A46D"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="PhoneTextBox"
                                 Height="30"
                                 FontSize="15"
                                 MaxLength="15"
                                 TextChanged="Input_TextChanged"
                                 PreviewTextInput="PhoneTextBox_PreviewTextInput"
                                 Margin="0,0,0,18"/>
                        <TextBlock Text="EMAIL ADDRESS"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#C5A46D"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="EmailTextBox"
                                 Height="30"
                                 FontSize="15"
                                 MaxLength="100"
                                 TextChanged="Input_TextChanged"
                                 Margin="0,0,0,15"/>
                        <TextBlock x:Name="ValidationTextBlock"
                                   FontSize="13"
                                   Foreground="#C5A46D"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#151922"
                        BorderBrush="#343B48"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="YOUR CONFIGURATION"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#C5A46D"
                                   Margin="0,0,0,15"/>
                        <TextBlock x:Name="SummaryTextBlock"
                                   FontSize="15"
                                   Foreground="#E8E8E8"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,25,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="BACK"
                            Width="130"
                            Height="42"
                            HorizontalAlignment="Left"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#C5A46D"
                            Background="#151922"
                            BorderBrush="#C5A46D"
                            BorderThickness="1"
                            Click="BackButton_Click"/>
                    <Button x:Name="SubmitButton"
                            Grid.Column="1"
                            Content="SUBMIT"
                            Width="190"
                            Height="42"
                            HorizontalAlignment="Right"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#090B10"
                            Background="#C5A46D"
                            BorderBrush="#C5A46D"
                            BorderThickness="1"
                            IsEnabled="False"
                            Click="SubmitButton_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
