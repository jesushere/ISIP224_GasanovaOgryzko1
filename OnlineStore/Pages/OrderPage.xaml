<Page x:Class="OnlineStore.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineStore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="OrderPage">

    <Grid Margin ="20" Background="AliceBlue">
        <ScrollViewer>
            <StackPanel Margin="30" Width="490"
                    HorizontalAlignment="Center">

                <TextBlock Text="Making an order"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

                <TextBlock Text="Full Name"/>
                <TextBox x:Name="FullNameTextBox"
                     Margin="0,5,0,15"/>

                <TextBlock Text="Email"/>
                <TextBox x:Name="EmailTextBox"
                     Margin="0,5,0,15"/>

                <TextBlock Text="Delivery Address"/>
                <TextBox x:Name="AddressTextBox"
                     Margin="0,5,0,20"/>

                <TextBlock Text="Your order:"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                <ListBox x:Name="OrderListBox"
                     Height="150"/>

                <TextBlock x:Name="TotalTextBlock"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,15,0,15"/>

                <Button Content="Place Order"
                    Height="40"
                    Click="Order_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
