<Page x:Class="OnlineStore.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineStore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="CartPage">

    <Grid Margin ="20" Background="AliceBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Cart"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <ListBox x:Name="CartListBox"
                 Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                Margin="5">

                        <TextBlock Text="{Binding Name}"
                                   Width="220"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding Price, StringFormat={}{0} RUB.}"
                                   Width="100"
                                   VerticalAlignment="Center"/>

                        <Button Content="Remove"
                                Click="Remove_Click"
                                Padding="5"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2"
                    Margin="0,15,0,0">

            <TextBlock x:Name="TotalTextBlock"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Button Content="Place Order"
                    Height="40"
                    Click="Order_Click"/>
        </StackPanel>

    </Grid>
</Page>
