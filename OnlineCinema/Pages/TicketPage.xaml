<Page x:Class="OnlineCinema.Pages.TicketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineCinema.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TicketPage">

    <Grid Background="AliceBlue">
        <Border Width="430"
                Padding="25"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Ticket confirmation"
                           FontSize="25"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>
                <TextBlock x:Name="MovieText"
                           FontSize="18"
                           Margin="0,5"/>
                <TextBlock x:Name="HallText"
                           FontSize="16"
                           Margin="0,5"/>
                <TextBlock x:Name="DateText"
                           FontSize="16"
                           Margin="0,5"/>
                <TextBlock x:Name="SeatText"
                           FontSize="16"
                           Margin="0,5"/>
                <TextBlock x:Name="PriceText"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,15,0,20"/>
                <Button Content="Confirm"
                        Height="40"
                        Click="Confirm_Click"/>
                <Button Content="Back"
                        Height="35"
                        Margin="0,10,0,0"
                        Click="Back_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
