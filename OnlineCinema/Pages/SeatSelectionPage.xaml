<Page x:Class="OnlineCinema.Pages.SeatSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineCinema.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SeatSelectionPage">

    <Grid Background="AliceBlue" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Choose your seats"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>
        <TextBlock Grid.Row="1"
                   Text="SCREEN"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>
        <ScrollViewer Grid.Row="2">
            <StackPanel>
                <CheckBox x:Name="HideOccupiedCheckBox"
                  Content="Hide occupied seats"
                  FontSize="15"
                  Margin="5,5,5,15"
                  Checked="HideOccupied_Checked"
                  Unchecked="HideOccupied_Unchecked"/>
                <ItemsControl x:Name="SeatsItemsControl"
                      HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="24"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding SeatNumber}"
                            Width="28"
                            Height="35"
                            Margin="2"
                            Click="Seat_Click"
                            Background="{Binding ButtonColor}"
                            IsEnabled="{Binding IsAvailable}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3"
                    Margin="0,15,0,0">
            <TextBlock x:Name="SelectedSeatText"
                       Text="Selected seat: none"
                       FontSize="16"
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="PriceText"
                       FontSize="16"
                       Margin="0,0,0,10"/>
            <Button Content="Continue"
                    Height="40"
                    Width="150"
                    HorizontalAlignment="Center"
                    Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Page>
