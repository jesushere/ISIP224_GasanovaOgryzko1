<Page x:Class="OnlineCinema.Pages.MoviesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineCinema.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MoviesPage">

    <Grid Background="AliceBlue" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="CINEMA ONLINE"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">
            <TextBox x:Name="SearchTextBox"
                     Width="300"
                     Height="30"
                     VerticalAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"/>
            <ComboBox x:Name="SortComboBox"
                      Width="140"
                      Height="30"
                      Margin="10,0,0,0"
                      SelectedIndex="0"
                      SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="Title"/>
                <ComboBoxItem Content="Highest-rated first"/>
                <ComboBoxItem Content="Lowest-rated first"/>
            </ComboBox>
            <Button Content="Account"
                    Width="50"
                    Margin="259,0,0,0"
                    Click="Account_Click"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="MoviesItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="200"
                                Margin="5"
                                Padding="10"
                                Background="White"
                                BorderBrush="Gray"
                                BorderThickness="1">
                            <StackPanel>
                                <Image Source="{Binding PosterPath}"
                                       Height="240"
                                       Width="170"
                                       Stretch="UniformToFill"
                                       Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding StartDate, StringFormat=Release date: {0:dd.MM.yyyy}}"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding AgeRating}"
                                           Margin="0,5,0,10"/>
                                <Button Content="View movie"
                                        Padding="5"
                                        Click="Movie_Click"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
