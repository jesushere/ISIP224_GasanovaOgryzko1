<Page x:Class="OnlineCinema.Pages.MovieDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineCinema.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MovieDetailsPage">

    <ScrollViewer Background="AliceBlue">
        <Grid Margin="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Image x:Name="PosterImage"
                       Height="340"
                       Width="220"
                       Stretch="UniformToFill"/>
                <TextBlock x:Name="RatingText"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,15,0,0"/>
                <TextBlock x:Name="AgeRatingText"
                           FontSize="16"
                           Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="25,0,0,0">
                <TextBlock x:Name="TitleText"
                           FontSize="30"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Description"
                           FontSize="19"
                           FontWeight="Bold"/>
                <TextBlock x:Name="GenresText"
                           FontSize="16"
                           Margin="0,10,0,15"/>
                <TextBlock x:Name="DescriptionText"
                           FontSize="16"
                           TextWrapping="Wrap"
                           Margin="0,5,0,20"/>
                <TextBlock Text="Available sessions"
                           FontSize="21"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>
                <ItemsControl x:Name="SessionsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Padding="12"
                                    Margin="0,5">
                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StartDateTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                   FontWeight="Bold"
                                                   FontSize="16"/>
                                        <TextBlock Text="{Binding Hall.Name}"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock Text="Hall rating:"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding Hall.Rating}"/>
                                        <TextBlock Text="{Binding TicketPrice, StringFormat=Price:{0} RUB}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Button Content="Choose seats"
                                            Width="120"
                                            Margin="15,0,0,0"
                                            Click="ChooseSeats_Click"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Back to movies"
                        Width="150"
                        Height="35"
                        HorizontalAlignment="Left"
                        Margin="0,20,0,0"
                        Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
