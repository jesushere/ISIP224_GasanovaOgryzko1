<Page x:Class="OnlineCinema.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineCinema.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccountPage">

    <Grid Background="AliceBlue" Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="My Account"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="15">
            <StackPanel>
                <TextBlock x:Name="FullNameText"
                           FontSize="19"
                           FontWeight="Bold"/>
                <TextBlock x:Name="EmailText"
                           FontSize="16"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2"
                   Text="My tickets"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,20,0,10"/>
        <ListBox x:Name="TicketsListBox"
                 Grid.Row="3"
                 Background="White"
                 BorderBrush="Gray"
                 BorderThickness="1"/>
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,15,0,0">
            <Button Content="Back to movies"
                    Width="150"
                    Height="35"
                    Click="Back_Click"/>
            <Button Content="Log out"
                    Width="100"
                    Height="35"
                    Margin="10,0,0,0"
                    Click="Logout_Click"/>
        </StackPanel>
    </Grid>
</Page>
